# MARFA website — development image (hot-reload)
FROM node:20-alpine

WORKDIR /app

# Install dependencies first (better layer caching)
COPY package.json package-lock.json* ./
RUN npm install

# Source is bind-mounted via docker-compose for hot-reload,
# but copy it in so the image is usable standalone too.
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
